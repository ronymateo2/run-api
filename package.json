{
  "name": "run-api",
  "description": "Rurana API — Cloudflare Worker + D1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rurana-db",
    "db:migrate:local": "wrangler d1 migrations apply rurana-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rurana-db --remote",
    "seed:neck:local": "wrangler d1 execute rurana-db --local --file=seeds/neck.sql",
    "seed:neck:remote": "wrangler d1 execute rurana-db --remote --file=seeds/neck.sql",
    "seed:history:local": "wrangler d1 execute rurana-db --local --file=seeds/history_demo.sql",
    "seed:history:remote": "wrangler d1 execute rurana-db --remote --file=seeds/history_demo.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.12.23",
    "jose": "5.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "typescript": "5.8.3",
    "wrangler": "4.56.0"
  }
}
