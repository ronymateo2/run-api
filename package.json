{
  "name": "run-api",
  "description": "Rurana API — Cloudflare Worker + D1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rurana-db",
    "db:migrate:local": "wrangler d1 migrations apply rurana-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rurana-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.12.23",
    "jose": "5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "typescript": "5.8.3",
    "wrangler": "4.56.0"
  }
}